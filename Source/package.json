{
  "name": "nes-ace",
  "productName": "NES ACE",
  "version": "1.0.0",
  "description": "A Windows desktop toolkit for SMB3 total-control TAS development, 6502 assembly, PPU payload generation, and TAS input conversion",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "call backend\\build_backend.bat && electron-forge start",
    "package": "call backend\\build_backend.bat && electron-forge package --platform=win32 --arch=x64",
    "make": "call backend\\build_backend.bat && electron-forge make --platform=win32 --arch=x64",
    "lint": "eslint --ext .ts,.tsx ."
  },
  "keywords": [],
  "author": {
    "name": "8inski"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "electron": "43.1.1",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "typescript": "~4.5.4",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "codejar": "4.3.0"
  }
}
